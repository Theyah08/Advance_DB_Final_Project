# Prosfora Gift Shop POS - Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=prosfora-secret-key-change-in-production-2026

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prosfora_db
DB_USER=postgres
DB_PASSWORD=postgres

# Upload Folder Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload
